# Ribbonfish's Raspberry Pi 3 A Plus profile and DRM card.
RIBBONFISH_PROFILE=pi3a-plus
RIBBONFISH_DRM_DEVICE=/dev/dri/card0
RIBBONFISH_DRM_GID=44

# For a Raspberry Pi 4, replace the three settings above with these values.
# Pi 4 DRM card numbers vary with driver load order; use the stable KMS alias.
# Confirm the numeric group with:
#   stat -L -c '%g %G %n' /dev/dri/by-path/platform-gpu-card
# RIBBONFISH_PROFILE=pi4
# RIBBONFISH_DRM_DEVICE=/dev/dri/by-path/platform-gpu-card
# RIBBONFISH_DRM_GID=44

# Optional immutable image pin; default is cyanautomation/ribbonfish:latest.
# RIBBONFISH_IMAGE=cyanautomation/ribbonfish:sha-<merge-commit-sha>
# RIBBONFISH_IMAGE=cyanautomation/ribbonfish@sha256:<manifest-digest>

# Offline by default. For Cloudflare sync, set this to bridge and add the URL and device ID.
RIBBONFISH_NETWORK_MODE=none
# RIBBONFISH_SYNC_URL=https://ribbonfish.example.workers.dev
# RIBBONFISH_DEVICE_ID=ribbonfish-01
