# Copy to .env and replace ALL example values.
# This file contains no token; keep the device token in secrets/device-token.
RIBBONFISH_VERSION=0.1.0
RIBBONFISH_API_URL=https://your-worker.example.com
RIBBONFISH_DEVICE_ID=office-pi-01

# Example ONLY: find the actual DRM node group on your Raspberry Pi.
# Agentlab currently uses /dev/dri/card1 (vc4-drm), owned by group video (GID 44).
# Re-check `ls /sys/class/drm` and `stat -c '%g %G %n' "$RIBBONFISH_DRM_DEVICE"` on each host.
RIBBONFISH_DRM_DEVICE=/dev/dri/card1
RIBBONFISH_DRM_GID=44

# Numeric GID of the dedicated host group that can read secrets/device-token.
# Create a `ribbonfish-token` group and set its numeric GID here.
RIBBONFISH_TOKEN_GID=
