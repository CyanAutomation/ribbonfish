# Immutable image pin. Update to a published sha-<merge commit SHA> tag when upgrading.
RIBBONFISH_VERSION=sha-128b052157f2b3c0d80e282eb1f7ab982ccb9411

# Ribbonfish is a Raspberry Pi 3 A Plus with one HDMI output.
RIBBONFISH_PROFILE=pi3a-plus
RIBBONFISH_CACHE_DIR=/var/lib/ribbonfish/cache

# Ribbonfish exposes /dev/dri/card0 as vc4-drm, group video (GID 44).
# Check the actual device and numeric group on each target before deployment.
RIBBONFISH_DRM_DEVICE=/dev/dri/card0
RIBBONFISH_DRM_GID=44

# Offline is the default. Set to bridge only for enrollment or Cloudflare sync.
RIBBONFISH_NETWORK_MODE=none
RIBBONFISH_SYNC_URL=
RIBBONFISH_SYNC_INTERVAL=1m
RIBBONFISH_DEVICE_ID=
