# Ribbonfish's Raspberry Pi 3 A Plus profile and detected DRM card.
RIBBONFISH_PROFILE=pi3a-plus
RIBBONFISH_DRM_DEVICE=/dev/dri/card0
RIBBONFISH_DRM_GID=44

# Offline by default. For Cloudflare sync, set this to bridge and add the URL and device ID.
RIBBONFISH_NETWORK_MODE=none
# RIBBONFISH_SYNC_URL=https://ribbonfish.example.workers.dev
# RIBBONFISH_DEVICE_ID=ribbonfish-01
