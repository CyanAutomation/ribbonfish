# Replace with a published immutable Docker Hub tag, such as sha-<merge commit SHA>.
RIBBONFISH_VERSION=sha-0123456789abcdef0123456789abcdef01234567

# Pi 4 profile. For the tested Pi 3 A+ use ./hardware-config.pi3a-plus.json and card0.
# For a Pi 3B use ./hardware-config.pi3b.json and verify its DRM card/GID.
RIBBONFISH_LOCAL_CONFIG=./hardware-config.pi4.json
RIBBONFISH_CONFIG_FILE=/etc/ribbonfish/config.json
RIBBONFISH_CACHE_DIR=/var/lib/ribbonfish/cache

# Agentlab Pi 4 currently exposes /dev/dri/card1 as vc4-drm, group video (GID 44).
# Check the actual device and numeric group on each target before deployment.
RIBBONFISH_DRM_DEVICE=/dev/dri/card1
RIBBONFISH_DRM_GID=44
