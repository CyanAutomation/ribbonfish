{
  "version": 1,
  "log_level": "info",
  "cache": {
    "directory": "/var/lib/ribbonfish/cache",
    "max_bytes": 52428800
  },
  "output": {
    "backend": "drm",
    "device": "/dev/dri/card0",
    "fit": "contain"
  },
  "playlists": [
    {
      "id": "operations",
      "assets": [
        { "path": "/assets/operations-overview.png" },
        { "path": "/assets/service-health.png" }
      ]
    }
  ],
  "displays": [
    {
      "id": "display-main",
      "playlist_id": "operations",
      "connector": "HDMI-A-1",
      "mode": "preferred",
      "rotation_interval": "15s"
    }
  ]
}
