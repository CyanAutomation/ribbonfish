{
  "version": 2,
  "log_level": "info",
  "cache": {
    "directory": "/var/lib/ribbonfish/cache",
    "max_bytes": 52428800
  },
  "output": {
    "backend": "drm",
    "device": "/dev/dri/card0",
    "fit": "contain"
  },
  "displays": [
    {
      "id": "display-main",
      "connector": "HDMI-A-1",
      "mode": "preferred"
    }
  ],
  "playlist": {
    "id": "default",
    "rotation_interval": "15s",
    "assets": [
      {
        "path": "/assets/deployment-pipeline.png"
      },
      {
        "path": "/assets/operations-overview.png"
      },
      {
        "path": "/assets/platform-status.png"
      },
      {
        "path": "/assets/service-health.png"
      }
    ]
  }
}
